---
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/profile';
---
<Layout title="About" description={`Biography and education of ${profile.name}.`}>
  <header class="page-heading"><p class="eyebrow">Background</p><h1>About me</h1><p>A little context behind the work.</p></header>
  <section class="split-section"><h2>Biography</h2><div class="prose">{profile.biography.map(text => <p>{text}</p>)}{profile.biographyIsPlaceholder && <span class="placeholder">Placeholder · biography to be added</span>}</div></section>
  <section class="split-section"><h2>Education</h2><div>{profile.education.map(item => <article class="education"><p class="eyebrow">{item.period}</p><h3>{item.degree}</h3><p>{item.institution}</p>{item.placeholder && <span class="placeholder">Placeholder · not a verified education record</span>}</article>)}</div></section>
  <section class="split-section"><h2>Affiliation</h2><div><p>{profile.role}<br />{profile.department}<br />{profile.institution}<br />{profile.location}</p></div></section>
</Layout>
