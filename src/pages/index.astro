---
import Layout from '../layouts/Layout.astro';
import PublicationList from '../components/PublicationList.astro';
import UpdateList from '../components/UpdateList.astro';
import { profile } from '../data/profile';
import { sortedPublications, sortedUpdates } from '../data/content';
const social = [
  { label: 'Email', href: profile.email ? `mailto:${profile.email}` : '' },
  { label: 'GitHub', href: profile.links.github },
  { label: 'Google Scholar', href: profile.links.scholar },
  { label: 'ORCID', href: profile.links.orcid },
];
---
<Layout title="Home">
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Personal academic homepage</p>
      <h1>{profile.name}</h1>
      <p class="role">{profile.role}<span class="separator" aria-hidden="true"> / </span><span class="muted">{profile.institution}</span></p>
      <p class="intro">{profile.introduction}</p>
      <div class="interests"><span class="small-label">Research interests</span>{profile.interests.map(interest => <span>{interest}</span>)}</div>
      <ul class="social-links">{social.map(link => <li>{link.href ? <a href={link.href}>{link.label} <span aria-hidden="true">↗</span></a> : <span class="unavailable">{link.label}<small>To be added</small></span>}</li>)}</ul>
      <a class="text-link" href="/about/">More about me <span aria-hidden="true">→</span></a>
    </div>
    <figure class="portrait"><img src={profile.avatar} alt={profile.avatarAlt} width="360" height="420" fetchpriority="high" />{profile.avatarIsPlaceholder && <figcaption>Portrait to be added</figcaption>}</figure>
  </section>
  <section class="section-block"><div class="section-heading"><div><p class="eyebrow">Recent notes</p><h2>Updates</h2></div><a href="/updates/">All updates <span aria-hidden="true">→</span></a></div><UpdateList items={sortedUpdates.slice(0, 3)} /></section>
  <section class="section-block"><div class="section-heading"><div><p class="eyebrow">Research output</p><h2>Publications</h2></div><a href="/publications/">All publications <span aria-hidden="true">→</span></a></div><PublicationList items={sortedPublications.slice(0, 3)} /></section>
  <section class="explore"><div><h2>A closer look at the work.</h2><p>Explore research directions and ongoing projects.</p></div><div class="explore-links"><a href="/research/">Research <span aria-hidden="true">↗</span></a><a href="/projects/">Projects <span aria-hidden="true">↗</span></a></div></section>
</Layout>
